;; hikari 光 — storage_battery cell (langgraph, WASM runtime)
;; ADR-2605261100 · R0 scaffold
{:cell/id "storage_battery"
 :cell/glyph "🔋"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_storage_battery"
 :cell/doc "Battery energy storage system — chemistry attestation (no PBDE/TCEP/rare-earth), charge/discharge cycle tracking, SoC/SoH monitoring. Produces generationRecord datoms for stored energy (state-of-charge transitions)."
 :cell/state-graph
 {:nodes [:assess-chemistry :validate-specs :record-soc :monitor-health]
  :entry :assess-chemistry
  :edges [[:assess-chemistry :validate-specs] [:validate-specs :record-soc]
          [:record-soc :monitor-health] [:monitor-health :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G4" "G5" "G6" "G10"]
 :cell/kotoba
 {:reads [:battery/id :battery/chemistry :battery/capacity-kwh]
  :writes [:generation-record/id :generation-record/battery-did :generation-record/soc-pct
           :generation-record/timestamp]}}
