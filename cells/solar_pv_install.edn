;; hikari 光 — solar_pv_install cell (langgraph, WASM runtime)
;; ADR-2605261100 · R0 scaffold
{:cell/id "solar_pv_install"
 :cell/glyph "☀️"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_solar_pv_install"
 :cell/doc "Solar PV panel installation attestation — parcel energy baseline, sourcing audit (Charter Rider §2(g)), biodiversity no-harm declaration. Produces parcelEnergyAttestation + installAttestation datoms."
 :cell/state-graph
 {:nodes [:assess-parcel :audit-sourcing :declare-biodiversity :finalize-attestation]
  :entry :assess-parcel
  :edges [[:assess-parcel :audit-sourcing] [:audit-sourcing :declare-biodiversity]
          [:declare-biodiversity :finalize-attestation] [:finalize-attestation :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G4" "G5" "G6" "G10"]
 :cell/kotoba
 {:reads [:parcel/did :parcel/location :parcel/area-sqm]
  :writes [:parcel-energy-attestation/id :parcel-energy-attestation/parcel-did
           :install-attestation/id :install-attestation/vendor :install-attestation/sourcing-audit]}}
