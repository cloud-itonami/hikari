;; hikari 光 — grid_edge cell (langgraph, WASM runtime)
;; ADR-2605261100 · R0 scaffold
{:cell/id "grid_edge"
 :cell/glyph "⚡"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_grid_edge"
 :cell/doc "Microgrid controller — real-time load balancing (solar + battery + geo base-load), frequency/voltage stabilization, load-shedding tolerance (no fossil backup). Coordinates distribution to facility consumers (mitsuho, yakushi, mitate, tatekata) and adherent baseline. R0 compute-only; R1+ dispatch gated by Council + consent."
 :cell/state-graph
 {:nodes [:aggregate-generation :estimate-demand :balance-flows :publish-grid-state]
  :entry :aggregate-generation
  :edges [[:aggregate-generation :estimate-demand] [:estimate-demand :balance-flows]
          [:balance-flows :publish-grid-state] [:publish-grid-state :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G5" "G6" "G10"]
 :cell/kotoba
 {:reads [:generation-record/id :generation-record/kw-pv :generation-record/soc-pct
          :consumption-audit-record/id :consumption-audit-record/period-kwh]
  :writes [:grid-edge-record/id :grid-edge-record/timestamp :grid-edge-record/net-load-kw
           :grid-edge-record/frequency-hz]}}
