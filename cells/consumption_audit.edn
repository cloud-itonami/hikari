;; hikari 光 — consumption_audit cell (langgraph, WASM runtime)
;; ADR-2605261100 · R0 scaffold
{:cell/id "consumption_audit"
 :cell/glyph "📊"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/agent.py"
 :cell/handler "handle_consumption_audit"
 :cell/doc "Consumption audit — aggregate-only per-period consumption (≥1h buckets; no smart-meter granular PII). Encrypted envelope (com.etzhayyim.encrypted.*) stores detailed per-load breakdown; datomic surface exposes only time-aggregated consumption for facility/adherent baseline tracking (G9 privacy gate)."
 :cell/state-graph
 {:nodes [:aggregate-loads :encrypt-detail :record-aggregate :finalize-audit]
  :entry :aggregate-loads
  :edges [[:aggregate-loads :encrypt-detail] [:encrypt-detail :record-aggregate]
          [:record-aggregate :finalize-audit] [:finalize-audit :end]]}
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G5" "G6" "G9" "G10"]
 :cell/kotoba
 {:reads []
  :writes [:consumption-audit-record/id :consumption-audit-record/period-kwh
           :consumption-audit-record/facility-did :consumption-audit-record/timestamp]}}
