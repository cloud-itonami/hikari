{:lexicon 1
 :id "com.etzhayyim.hikari.parcelEnergyAttestation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["parcelDid" "energyPotential" "biodiversityNoHarm"]
    :properties
    {:parcelDid {:type "string" :description "LANDS registry DID (4-layer land trust)"}
     :location {:type "string" :description "geolocation ref for solar/geo baseline"}
     :areaSqm {:type "number" :description "parcel area in square meters"}
     :solarPotentialKwh {:type "number" :description "annual solar generation estimate (kWh)"}
     :geothermalPotentialKw {:type "number" :description "baseload thermal (kW) if <=500m"}
     :energyPotential {:type "string" :description "combined renewable potential summary"}
     :biodiversityNoHarm {:type "boolean" :description "G4 ecosystem baseline compliance"}
     :attestationDid {:type "string" :description "operator/Council DID attesting"}
     :timestamp {:type "string" :description "ISO-8601"}}}}}}
